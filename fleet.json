{
  "$schema": "https://raw.githubusercontent.com/crvouga/dev-fleet/main/schema/fleet.schema.json",
  "version": 3,
  "source": {
    "repository": "https://github.com/crvouga/dev-fleet.git"
  },
  "secrets": {
    "provider": "vault",
    "address": "https://vault.chrisvouga.dev",
    "mount": "secret",
    "locations": {
      "proxy-client-key": {
        "path": "personal/prd",
        "field": "CLIPROXY_FLEET_CLIENT_API_KEY"
      },
      "monitoring-account-password": {
        "path": "personal/prd",
        "field": "BESZEL_FLEET_AUTH"
      },
      "monitoring-tunnel-token": {
        "path": "beszel/tunnel",
        "field": "TUNNEL_TOKEN"
      },
      "proxy-tunnel-token": {
        "path": "cliproxy-fleet/tunnel",
        "field": "TUNNEL_TOKEN"
      },
      "monitoring-backup-access-key": {
        "path": "fleet-recovery/monitoring",
        "field": "S3_ACCESS_KEY_ID"
      },
      "monitoring-backup-secret-key": {
        "path": "fleet-recovery/monitoring",
        "field": "S3_SECRET_ACCESS_KEY"
      }
    }
  },
  "git": {
    "name": "Chris Vouga",
    "email": "49178412+crvouga@users.noreply.github.com"
  },
  "manager": {
    "id": "chriss-macbook-air",
    "os": "macOS",
    "network": {
      "tailscaleName": "chriss-macbook-air-1.tail4829dc.ts.net",
      "user": "chrisvouga"
    },
    "neverSleepOnPower": true
  },
  "workers": [
    {
      "id": "chris-vouga-ms-a2",
      "ssh": "chris-vouga-ms-a2",
      "os": "linux",
      "network": {
        "tailscaleName": "chris-vouga-ms-a2.tail4829dc.ts.net",
        "sshPort": 22,
        "user": "chris-vouga",
        "t3Port": 3773
      }
    },
    {
      "id": "chris-vouga-mac-studio",
      "ssh": "chris-vouga-mac-studio",
      "os": "linux",
      "network": {
        "tailscaleName": "chris-vouga-mac-studio.tail4829dc.ts.net",
        "sshPort": 22,
        "user": "chrisvouga",
        "t3Port": 3773
      }
    },
    {
      "id": "chris-vouga-ms-a2-2",
      "os": "linux",
      "network": {
        "tailscaleName": "chris-vouga-ms-a2-2.tail4829dc.ts.net",
        "sshPort": 22,
        "user": "chris-vouga",
        "t3Port": 3773,
        "hostKey": "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIUc5MMxpCViOfMFOUinWKxE58aDI9SJp3Z3BXwoPV0t"
      }
    }
  ],
  "services": {
    "proxy": {
      "endpoint": "https://cli-proxy.chrisvouga.dev"
    },
    "monitoring": {
      "hubPort": 8443,
      "publicUrl": "https://beszel.chrisvouga.dev",
      "managerAccount": "fleet-manager@chrisvouga.dev",
      "viewerAccount": "public-viewer@chrisvouga.dev",
      "backups": {
        "schedule": "15 3 * * *",
        "keep": 7,
        "storage": {
          "bucket": "crvouga-beszel-backups",
          "region": "auto",
          "endpoint": "https://2698e76355a8c8d1ee21e15fa9fd44f7.r2.cloudflarestorage.com",
          "forcePathStyle": true
        }
      }
    }
  },
  "ubuntu": {
    "release": "26.04",
    "architectures": ["amd64", "arm64"]
  },
  "worker": {
    "requiredCapabilities": [
      "github",
      "vault",
      "t3",
      "toolchain",
      "workstation",
      "worker"
    ],
    "githubLogin": "crvouga",
    "vaultUser": "crvouga",
    "toolchain": "mise.lock",
    "agentProfile": "proxy",
    "unattendedSudo": true,
    "persistentT3": true,
    "neverSleep": true,
    "exposure": {
      "tailnetOnlyPorts": [
        { "protocol": "tcp", "port": 3389 },
        { "protocol": "tcp", "port": 3390 },
        { "protocol": "tcp", "port": 3391 }
      ]
    }
  },
  "state": {
    "bucket": "crvouga-fleet-state",
    "region": "auto",
    "endpoint": "https://2698e76355a8c8d1ee21e15fa9fd44f7.r2.cloudflarestorage.com",
    "prefix": "dev-fleet"
  }
}
